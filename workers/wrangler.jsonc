{
  // Deploy to Cloudflare 按钮使用此配置自动创建资源
  "name": "tgbot-rss",
  "main": "_worker.js",
  "compatibility_date": "2024-01-01",

  // KV 命名空间 (Deploy 按钮会自动创建)
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": ""
    }
  ],

  // 定时触发器 - 每分钟检查 RSS
  "triggers": {
    "crons": ["* * * * *"]
  },

  // 环境变量 (Deploy 按钮会提示用户填入)
  "vars": {
    "ADMIN_ID": "0"
  }

  // BOT_TOKEN 通过 Secret 设置，Deploy 按钮会提示输入
}
